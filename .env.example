# ============================================================
# MacroEngine — Environment Variables
# ============================================================
# Copy this file to .env and edit the values below.
#   cp .env.example .env
#
# Lines marked REQUIRED must be set before starting.
# Lines marked OPTIONAL enable extra features; the app works without them.
# ============================================================

# ----------------------------------------------------------
# REQUIRED
# ----------------------------------------------------------

# Postgres connection string.
# If using docker-compose, leave this as-is — the compose file overrides it.
DATABASE_URL=postgresql://macroengine:macroengine@postgres:5432/macroengine

# Shared login password (min 12 characters).
# Everyone who uses this instance logs in with the same password.
MACROENGINE_PASSWORD=please-change-me

# HMAC secret for signing session cookies.
# Generate one with:  openssl rand -base64 32
MACROENGINE_SECRET=please-change-me-with-openssl-rand

# ----------------------------------------------------------
# OPTIONAL — features degrade gracefully when unset
# ----------------------------------------------------------

# Garmin SSO proxy URL for syncing step/calorie data.
# DEFAULT: kostas's shared Cloudflare Worker (see warning below).
# To disable Garmin integration entirely, leave this blank.
#
# !! PRIVACY WARNING !!
# The default proxy routes your Garmin credentials through a third-party
# Cloudflare Worker during SSO. For real use, deploy your own — it takes
# 5 minutes. See cloudflare/README.md for instructions.
GARMIN_AUTH_PROXY_URL=https://garmin-auth.kostasgeorgiou.workers.dev

# API key for AI-powered natural-language meal parsing.
# When unset, the "Describe a meal" input shows "AI parsing disabled".
# AI_GATEWAY_API_KEY=

# Secret for authenticating external cron/scheduler requests to /api/cron/*.
# When unset, cron endpoints are unprotected (only matters if publicly exposed).
# CRON_SECRET=
