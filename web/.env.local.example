# Primary Neon Postgres connection
DATABASE_URL=postgresql://user:pass@host.neon.tech/neondb?sslmode=require

# Separate Neon branch for tests (copy-on-write clone)
# Create via: neonctl branches create --name test
DATABASE_URL_TEST=postgresql://user:pass@host.neon.tech/neondb?sslmode=require

# Auth secret for API middleware (cookie-based)
MACROENGINE_SECRET=

# Vercel AI Gateway key (for voice / NL logging in Phase 7)
AI_GATEWAY_API_KEY=

# Optional: soma project's Neon DB for Garmin data sync. If unset, Garmin sync is disabled.
SOMA_DATABASE_URL=
